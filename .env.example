# TimeBridge Production Environment Configuration Contract

# ---------------------------------------------------------
# DATABASE
# PostgreSQL configuration for Prisma ORM
# ---------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=timebridge_user
DB_PASSWORD=CHANGE_ME
DB_NAME=timebridge_db
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# ---------------------------------------------------------
# REDIS
# Redis connection for Queue (BullMQ) & Cache
# ---------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# ---------------------------------------------------------
# AUTH & SECURITY
# Authentication and JWT secrets
# ---------------------------------------------------------
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
CORS_ALLOWED_ORIGINS=https://timebridge.company.com,https://admin.timebridge.company.com

# ---------------------------------------------------------
# API
# API server configuration
# ---------------------------------------------------------
API_PORT=3000
NODE_ENV=production

# ---------------------------------------------------------
# FRONTEND
# Vue 3 Vite application variables
# ---------------------------------------------------------
VITE_API_URL=https://api.timebridge.company.com

# ---------------------------------------------------------
# SFTP
# Device logs file transfer configuration
# ---------------------------------------------------------
SFTP_HOST=sftp.device-network.com
SFTP_PORT=22
SFTP_USERNAME=timebridge_sftp
SFTP_PASSWORD=CHANGE_ME
SFTP_REMOTE_DIR=/outbox

# ---------------------------------------------------------
# SAP / HCI
# SAP Cloud Integration boundary
# ---------------------------------------------------------
SAP_HCI_URL=https://hci.sap.company.com/cxf/attendance
SAP_HCI_USERNAME=sap_integration_user
SAP_HCI_PASSWORD=CHANGE_ME

# ---------------------------------------------------------
# LOGGING
# System observability (Optional structured logging level)
# ---------------------------------------------------------
LOG_LEVEL=info
